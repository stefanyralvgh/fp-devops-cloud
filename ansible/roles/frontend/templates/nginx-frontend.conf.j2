server {
    listen 80 default_server;
    server_name _;

    root /opt/movie-analyst-ui;
    index index.html;

    # Alias: /authors -> /reviewers
    location = /authors {
        proxy_pass http://{{ alb_dns_name }}/reviewers;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API endpoints proxy to ALB
    location ~ ^/(movies|reviewers|publications|pending|health|api)(/.*)?$ {
        proxy_pass http://{{ alb_dns_name }}$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend static files
    location / {
        try_files $uri $uri/ /index.html;
    }
}